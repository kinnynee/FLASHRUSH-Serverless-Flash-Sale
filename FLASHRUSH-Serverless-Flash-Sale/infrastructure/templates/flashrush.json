{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "FLASHRUSH isolated lab; nine application services",
  "Resources": {
    "Products": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "flashrush-lab-products",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "productId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "productId",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "Orders": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "flashrush-lab-orders",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "orderId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "orderId",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "Campaigns": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "flashrush-lab-campaigns",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "campaignId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "campaignId",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "DLQ": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "flashrush-lab-dlq",
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "RedriveAllowPolicy": {
          "redrivePermission": "byQueue",
          "sourceQueueArns": [
            {
              "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:flashrush-lab-orders"
            }
          ]
        }
      }
    },
    "Queue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "flashrush-lab-orders",
        "VisibilityTimeout": 90,
        "MessageRetentionPeriod": 345600,
        "ReceiveMessageWaitTimeSeconds": 20,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DLQ",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        }
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "flashrush-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Scan"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Products",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Scan",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Campaigns",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Orders",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Queue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/flashrush-lab-api:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "flashrush-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Queue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Products",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "Orders",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/flashrush-lab-worker:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/flashrush-lab-api",
        "RetentionInDays": 7
      }
    },
    "Api": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "flashrush-lab-api",
        "Runtime": "python3.12",
        "Handler": "app.api",
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Timeout": 15,
        "MemorySize": 256,
        "Code": {
          "S3Bucket": "flashrush-lab-artifacts-303278700480-us-east-1",
          "S3Key": "lambda/87876ed885fe56003c78246206e9c280d005341ae2f617e682ddf80d5ce71060.zip"
        },
        "Environment": {
          "Variables": {
            "PRODUCTS_TABLE": {
              "Ref": "Products"
            },
            "ORDERS_TABLE": {
              "Ref": "Orders"
            },
            "CAMPAIGNS_TABLE": {
              "Ref": "Campaigns"
            },
            "QUEUE_URL": {
              "Ref": "Queue"
            }
          }
        },
        "Architectures": [
          "arm64"
        ]
      },
      "DependsOn": "ApiLog"
    },
    "WorkerLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/flashrush-lab-worker",
        "RetentionInDays": 7
      }
    },
    "Worker": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "flashrush-lab-worker",
        "Runtime": "python3.12",
        "Handler": "app.worker",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Timeout": 15,
        "MemorySize": 256,
        "Code": {
          "S3Bucket": "flashrush-lab-artifacts-303278700480-us-east-1",
          "S3Key": "lambda/87876ed885fe56003c78246206e9c280d005341ae2f617e682ddf80d5ce71060.zip"
        },
        "Environment": {
          "Variables": {
            "PRODUCTS_TABLE": {
              "Ref": "Products"
            },
            "ORDERS_TABLE": {
              "Ref": "Orders"
            },
            "QUEUE_URL": {
              "Ref": "Queue"
            }
          }
        },
        "Architectures": [
          "arm64"
        ]
      },
      "DependsOn": "WorkerLog"
    },
    "Mapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "Queue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "Worker"
        },
        "BatchSize": 1,
        "MaximumBatchingWindowInSeconds": 0,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "ScalingConfig": {
          "MaximumConcurrency": 5
        },
        "Enabled": true
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "flashrush-lab-api",
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            {
              "Fn::Sub": "https://${Distribution.DomainName}"
            },
            "http://localhost:5173",
            "http://127.0.0.1:5173"
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "PATCH",
            "OPTIONS"
          ],
          "AllowHeaders": [
            "content-type",
            "idempotency-key",
            "x-order-token"
          ],
          "MaxAge": 300
        }
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "Api",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 20000
      }
    },
    "Route0": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /products",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Route1": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /products/{productId}",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Route2": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /orders",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Route3": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /orders/{orderId}",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Route4": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /campaigns",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Route5": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /campaigns/{campaignId}",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Route6": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /admin/campaigns",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Route7": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "PATCH /admin/campaigns/{campaignId}",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "AccessLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/apigateway/flashrush-lab",
        "RetentionInDays": 7
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 10,
          "ThrottlingRateLimit": 5,
          "DetailedMetricsEnabled": false
        },
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "AccessLog",
              "Arn"
            ]
          },
          "Format": "{\"requestId\":\"$context.requestId\",\"status\":\"$context.status\",\"routeKey\":\"$context.routeKey\",\"latency\":\"$context.responseLatency\"}"
        }
      }
    },
    "ApiPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Api"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    },
    "Website": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "flashrush-lab-web-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "OAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": "flashrush-lab-oac",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SpaRewrite": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": "flashrush-lab-spa-rewrite",
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Rewrite application routes only; preserve asset errors",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) { var r = event.request; if (/^\\/(products|checkout|orders|admin|monitoring)(\\/.*)?$/.test(r.uri) && !/\\.[^/]+$/.test(r.uri)) { r.uri = '/index.html'; } return r; }"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "DefaultRootObject": "index.html",
          "PriceClass": "PriceClass_100",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "Origins": [
            {
              "Id": "website",
              "DomainName": {
                "Fn::GetAtt": [
                  "Website",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "OAC"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "website",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SpaRewrite",
                    "FunctionARN"
                  ]
                }
              }
            ],
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6"
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    },
    "WebsitePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Website"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${Website.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Website",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Website.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "flashrush-lab-alerts"
      }
    },
    "AlertsPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "Alerts"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "Alerts"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:flashrush-lab-*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "DLQAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "flashrush-lab-dlqalarm",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "DLQ",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "WorkerErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "flashrush-lab-workererroralarm",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Worker"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "QueueAgeAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "flashrush-lab-queueagealarm",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateAgeOfOldestMessage",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "Queue",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 300,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    },
    "WebsiteUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "WebsiteBucket": {
      "Value": {
        "Ref": "Website"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "ProductsTable": {
      "Value": {
        "Ref": "Products"
      }
    },
    "OrdersTable": {
      "Value": {
        "Ref": "Orders"
      }
    },
    "CampaignsTable": {
      "Value": {
        "Ref": "Campaigns"
      }
    },
    "QueueUrl": {
      "Value": {
        "Ref": "Queue"
      }
    },
    "DLQUrl": {
      "Value": {
        "Ref": "DLQ"
      }
    },
    "AlertsTopicArn": {
      "Value": {
        "Ref": "Alerts"
      }
    }
  }
}
