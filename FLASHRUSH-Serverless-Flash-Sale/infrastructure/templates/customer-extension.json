  "Outputs": {
    "CustomerPoolId": {
      "Value": {
        "Ref": "CustomerPool"
      }
    },
    "CustomerClientId": {
      "Value": {
        "Ref": "CustomerClient"
      }
    },
    "CustomerRegion": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "CustomersTable": {
      "Value": {
        "Ref": "CustomerData"
      }
    }
  },
  "ApiEnvironment": {
    "CUSTOMERS_TABLE": {
      "Ref": "CustomerData"
    },
    "CUSTOMER_CLIENT_ID": {
      "Ref": "CustomerClient"
    },
    "CUSTOMER_ISSUER": {
      "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${CustomerPool}"
    }
  },
  "WorkerEnvironment": {
    "CUSTOMERS_TABLE": {
      "Ref": "CustomerData"
    },
    "CUSTOMER_CLIENT_ID": {
      "Ref": "CustomerClient"
    },
    "CUSTOMER_ISSUER": {
      "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${CustomerPool}"
    }
  },
  "ApiRoleStatements": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": {
        "Fn::GetAtt": [
          "CustomerData",
          "Arn"
        ]
      }
    }
  ],
  "WorkerRoleStatements": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": {
        "Fn::GetAtt": [
          "CustomerData",
          "Arn"
        ]
      }
    }
  ]
