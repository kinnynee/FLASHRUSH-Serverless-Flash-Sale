# Set to true to inspect the service error and retry UI, then restart Vite.
VITE_DEMO_SERVICE_ERROR=false
VITE_ORDER_MODE=http
# Set to the deployed AWS API Gateway endpoint. Monitoring never falls back to mock.
VITE_API_BASE_URL=
# Public identifiers from CloudFormation outputs; never put admin secrets here.
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=
